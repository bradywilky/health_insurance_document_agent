# Replace with your own local profile name. Never add credentials here.
AWS_PROFILE=dev-profile
AWS_DEFAULT_REGION=us-east-1
# Optional; overrides AWS_DEFAULT_REGION for Bedrock, S3 documents and the trace archive.
# AWS_REGION=us-east-1
# Default answering model, a key of MODELS in backend/config/settings.py.
TABLES_MODEL=maverick
# Ask the planner, without tools, for its next step and why before each tool call (default off).
# PLANNER_REASONING=true
# Model for semantic profiles generated at upload (default maverick).
# ENRICHMENT_MODEL=maverick
# Optional deployment-specific inference profile ID or ARN:
# BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=4096
# Attempts per Bedrock call, including retries after throttling (adaptive backoff).
BEDROCK_MAX_ATTEMPTS=6

# Choose local for development or s3 for persistent uploads.
DOCUMENTS_STORAGE=local
# Shared by both apps; relative paths resolve from the project root.
DOCUMENTS_LOCAL_DIR=data/document_library
# Saved documents: s3://<bucket>/<prefix base><group name>/<ppdocs>/<filename>/ (manifest.json and outputs).
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_PREFIX_BASE=content/health_insurance_document_agent/
# Default group; ask_question(group_name=...) or the Lambda event's group_name overrides it per request.
# Also applies in local mode, under DOCUMENTS_LOCAL_DIR.
DOCUMENTS_GROUP_NAME=
# Must end in /preprocessed. Originals go to the sibling raw folder (documents/raw).
DOCUMENTS_S3_PREFIX_PPDOCS=documents/preprocessed
# Optional; otherwise the destination bucket encryption policy applies.
# DOCUMENTS_S3_KMS_KEY_ID=

# Trace archive (backend/observability/archive.py): every question and document change as one JSON trace, the same
# spans Datadog receives. local writes files under TRACE_ARCHIVE_LOCAL_DIR; s3 writes one object per trace; off.
# Relative paths resolve from the project root.
TRACE_ARCHIVE=local
TRACE_ARCHIVE_LOCAL_DIR=data/traces
# TRACE_ARCHIVE_S3_BUCKET=        # defaults to DOCUMENTS_S3_BUCKET
# TRACE_ARCHIVE_S3_PREFIX=        # defaults to DOCUMENTS_S3_PREFIX_BASE
# TRACE_ARCHIVE_S3_KMS_KEY_ID=    # defaults to DOCUMENTS_S3_KMS_KEY_ID
# Fail a question when its trace cannot be archived.
TRACE_ARCHIVE_REQUIRED=false
# APP_VERSION=                    # e.g. the deployed git SHA; otherwise a hash of the backend source

# Datadog LLM Observability (backend/observability/tracing.py). In AWS Lambda the Datadog layers read these; see
# README. Leave these unset locally unless you want local runs sent to Datadog; traces are archived either way.
# DD_LLMOBS_ENABLED=true
# DD_LLMOBS_ML_APP=health-insurance-document-agent
# DD_SITE=datadoghq.com
# Record prompt, response, question, answer and tool text in traces (Datadog and the archive). Can contain PHI.
# The chat app and CLI record it locally regardless.
TRACE_CONTENT=false
