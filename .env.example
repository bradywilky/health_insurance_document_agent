# Replace with your own local profile name. Never add credentials here.
AWS_PROFILE=dev-profile
AWS_DEFAULT_REGION=us-east-1
TABLES_MODEL=maverick
# Optional deployment-specific inference profile ID or ARN:
# BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=4096

# Choose local for development or s3 for persistent uploads.
DOCUMENTS_STORAGE=local
# Shared by both apps; relative paths resolve from the project root.
DOCUMENTS_LOCAL_DIR=data/document_library
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_PREFIX=document-agent/
# Optional; otherwise the destination bucket encryption policy applies.
# DOCUMENTS_S3_KMS_KEY_ID=
