# Replace with your own local profile name. Never add credentials here.
AWS_PROFILE=dev-profile
AWS_DEFAULT_REGION=us-east-1
# Optional; overrides AWS_DEFAULT_REGION for Bedrock, S3 documents and audit records.
# AWS_REGION=us-east-1
# Default answering model, a key of MODELS in backend/config/settings.py.
TABLES_MODEL=maverick
# Model for semantic profiles generated at upload (default maverick).
# ENRICHMENT_MODEL=maverick
# Optional deployment-specific inference profile ID or ARN:
# BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=4096
# Attempts per Bedrock call, including retries after throttling (adaptive backoff).
BEDROCK_MAX_ATTEMPTS=6

# Choose local for development or s3 for persistent uploads.
DOCUMENTS_STORAGE=local
# Shared by both apps; relative paths resolve from the project root.
DOCUMENTS_LOCAL_DIR=data/document_library
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_PREFIX=document-agent/
# Optional; otherwise the destination bucket encryption policy applies.
# DOCUMENTS_S3_KMS_KEY_ID=

# Audit records (backend/observability/audit.py). local writes JSON lines under AUDIT_LOCAL_DIR; s3 writes one
# object per record. Metadata records hold no question or answer text. Relative paths resolve from the project root.
AUDIT_STORAGE=local
AUDIT_LOCAL_DIR=data/audit
# AUDIT_S3_BUCKET=            # defaults to DOCUMENTS_S3_BUCKET
# AUDIT_S3_PREFIX=document-agent/
# AUDIT_S3_KMS_KEY_ID=        # defaults to DOCUMENTS_S3_KMS_KEY_ID
# Also record question, answer and evidence in a separate content tier. Can contain PHI.
AUDIT_CONTENT=false
# Fail a question when its audit record cannot be written.
AUDIT_REQUIRED=false
# APP_VERSION=                # e.g. the deployed git SHA; otherwise a hash of the backend source

# Datadog LLM Observability (backend/observability/llmobs.py). In AWS Lambda the Datadog layers read these; see
# README. Locally the chat app, CLI and evaluations capture the same spans in memory instead
# (development/observability), so leave these unset unless you want local runs sent to Datadog.
# DD_LLMOBS_ENABLED=true
# DD_LLMOBS_ML_APP=health-insurance-document-agent
# DD_SITE=datadoghq.com
# Send prompt, response, question and answer text to Datadog. Can contain PHI. The local capture always records it.
TRACE_CONTENT=false
